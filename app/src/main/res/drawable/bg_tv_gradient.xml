<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Oceanic-Navy & Graphite Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0D1524"
                android:centerColor="#080D17"
                android:endColor="#05070C" />
        </shape>
    </item>
    <!-- Soft Top-Right Ambient Cyan Glow -->
    <item android:top="-180dp" android:right="-280dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="460dp"
                android:centerColor="#261A4E7A"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Subtle Bottom-Left Deep Blue Ambient Lighting -->
    <item android:left="-280dp" android:bottom="-240dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="380dp"
                android:centerColor="#1A123856"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
