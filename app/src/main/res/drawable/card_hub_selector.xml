<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135" android:startColor="#E633526B" android:centerColor="#E523334B" android:endColor="#E51B2638" />
            <stroke android:width="2dp" android:color="#77A6E8FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135" android:startColor="#CC24384F" android:endColor="#CC162332" />
            <stroke android:width="1dp" android:color="#5585D8F5" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135" android:startColor="#B81E2A3B" android:endColor="#B8121C2A" />
            <stroke android:width="1dp" android:color="#332D4056" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>