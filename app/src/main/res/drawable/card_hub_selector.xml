<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#331A20"
                android:endColor="#1E283A" />
            <stroke android:width="3dp" android:color="#00F0FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141924" />
            <stroke android:width="1dp" android:color="#242C3D" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
