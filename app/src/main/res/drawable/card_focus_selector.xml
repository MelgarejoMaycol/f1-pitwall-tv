<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Electric Cyan Halo & Specular Illuminated Glass -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#3300F0FF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="135"
                        android:startColor="#F0243554"
                        android:centerColor="#E61A2640"
                        android:endColor="#E6111B30" />
                    <stroke android:width="2.5dp" android:color="#00F0FF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Selected -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#E6261524"
                android:endColor="#CC140E1A" />
            <stroke android:width="2dp" android:color="#FF2A24" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Default Frosted Glass Surface -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#B3131F35"
                android:centerColor="#990E1729"
                android:endColor="#8C091120" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
