<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135" android:startColor="#E52B4058" android:centerColor="#E51C2A3E" android:endColor="#E5121B2C" />
            <stroke android:width="2dp" android:color="#66D8F5FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135" android:startColor="#CC25374D" android:endColor="#CC162234" />
            <stroke android:width="1.5dp" android:color="#5585D8F5" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135" android:startColor="#C91D2939" android:centerColor="#C915202F" android:endColor="#C9111B29" />
            <stroke android:width="1dp" android:color="#332E4660" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>