<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135" android:startColor="#F0243B54" android:centerColor="#F018283C" android:endColor="#F0101C2B" />
            <stroke android:width="2dp" android:color="#00F0FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135" android:startColor="#E61C2C40" android:endColor="#E6121E2E" />
            <stroke android:width="1.5dp" android:color="#5538BDF8" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="135" android:startColor="#D9131C2A" android:centerColor="#D90E1622" android:endColor="#D90A0F18" />
            <stroke android:width="1dp" android:color="#202F42" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
