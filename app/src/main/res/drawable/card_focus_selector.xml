<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/f1_focused_bg" />
            <stroke android:width="3dp" android:color="@color/f1_focused" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/f1_surface_card" />
            <stroke android:width="1dp" android:color="#2D3344" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
