<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/f1_focused_bg" />
            <stroke android:width="3dp" android:color="@color/f1_red" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/f1_surface_card" />
            <stroke android:width="2dp" android:color="@color/f1_red" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/f1_surface" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
