<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#263146" />
            <stroke android:width="2.5dp" android:color="#00F0FF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A161A" />
            <stroke android:width="2dp" android:color="#E10600" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141926" />
            <stroke android:width="1dp" android:color="#222B3D" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
