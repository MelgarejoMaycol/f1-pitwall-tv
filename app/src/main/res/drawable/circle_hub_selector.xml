<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient android:type="linear" android:angle="135" android:startColor="#E63C5572" android:endColor="#E51B283B" />
            <stroke android:width="2dp" android:color="#88B8EDFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="#CC25364B" />
            <stroke android:width="1.5dp" android:color="#5585D8F5" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:type="linear" android:angle="135" android:startColor="#B8202B3C" android:endColor="#B8131D2A" />
            <stroke android:width="1dp" android:color="#332E435A" />
        </shape>
    </item>
</selector>