<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient android:type="linear" android:angle="135" android:startColor="#F03D5C7A" android:endColor="#F01E2E42" />
            <stroke android:width="2.5dp" android:color="#00F0FF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="#CC25364B" />
            <stroke android:width="1.5dp" android:color="#5585D8F5" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:type="linear" android:angle="135" android:startColor="#B8202B3C" android:endColor="#B8131D2A" />
            <stroke android:width="1dp" android:color="#332E435A" />
        </shape>
    </item>
</selector>
