<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark background with gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#0D111A"
                android:centerColor="#131926"
                android:endColor="#182030" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#2A354A" />
        </shape>
    </item>
    <!-- Left racing stripe accent -->
    <item android:right="980dp">
        <shape android:shape="rectangle">
            <solid android:color="#E10600" />
            <corners
                android:topLeftRadius="16dp"
                android:bottomLeftRadius="16dp" />
        </shape>
    </item>
</layer-list>
