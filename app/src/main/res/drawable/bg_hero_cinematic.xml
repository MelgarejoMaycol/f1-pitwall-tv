<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Ambient Glow Diffusion -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#268B5CF6"
                android:centerColor="#1A00F0FF"
                android:endColor="#100A1426" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Deep Frosted Petroleum Base with Light Reflections -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#F2091222"
                android:centerColor="#EA101C32"
                android:endColor="#F2152440" />
            <corners android:radius="17dp" />
            <stroke android:width="1.5dp" android:color="#30FFFFFF" />
        </shape>
    </item>

    <!-- Top Specular Glass Reflection Line -->
    <item android:bottom="266dp" android:left="8dp" android:right="8dp" android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#55FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- Left Apex Racing Neon Accent -->
    <item android:right="980dp" android:left="3dp" android:top="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FF2A24"
                android:centerColor="#E10600"
                android:endColor="#990000" />
            <corners
                android:topLeftRadius="16dp"
                android:bottomLeftRadius="16dp" />
        </shape>
    </item>
</layer-list>
