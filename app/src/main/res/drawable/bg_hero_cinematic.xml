<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Glassmorphism Surface Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#E6152336"
                android:centerColor="#E60F1A2A"
                android:endColor="#E609101C" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#243850" />
        </shape>
    </item>
    <!-- Soft Ambient Top Right Cyan Mesh Lighting -->
    <item android:top="-140dp" android:right="-200dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="340dp"
                android:centerColor="#331A5680"
                android:endColor="#00000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Precision F1 Racing Red Left Indicator Accent -->
    <item android:gravity="left">
        <shape android:shape="rectangle">
            <size android:width="5dp" />
            <solid android:color="#E10600" />
            <corners android:topLeftRadius="20dp" android:bottomLeftRadius="20dp" />
        </shape>
    </item>
</layer-list>
