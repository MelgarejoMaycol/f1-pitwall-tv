<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_glass_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- Flag / Category Badge -->
    <TextView
        android:id="@+id/tvRcFlagBadge"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:background="#EAB308"
        android:gravity="center"
        android:paddingHorizontal="6dp"
        android:text="AMARILLA"
        android:textColor="#000000"
        android:textSize="9sp"
        android:textStyle="bold" />

    <!-- Message & Time -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRcMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YELLOW IN TRACK SECTOR 2"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRcCategoryTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sector 2 • 04:02:15"
            android:textColor="@color/text_muted"
            android:textSize="8sp" />
    </LinearLayout>

</LinearLayout>
