<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="125dp"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/card_focus_selector"
    android:focusable="true"
    android:clickable="true"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top line: Flag + Round + Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivGpFlag"
            android:layout_width="28dp"
            android:layout_height="18dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvGpRound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="R01"
            android:textColor="@color/f1_red"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvGpStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#15803D"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="COMPLETADA"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- GP Name & Location -->
    <TextView
        android:id="@+id/tvGpName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Bahrain Grand Prix"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGpCircuit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Sakhir • International Circuit"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvGpDates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="29 Feb - 02 Mar"
        android:textColor="@color/text_muted"
        android:textSize="10sp" />
</LinearLayout>
