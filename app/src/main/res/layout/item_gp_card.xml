<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardGpContainer"
    android:layout_width="230dp"
    android:layout_height="140dp"
    android:layout_marginHorizontal="7dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/card_focus_selector"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp"
    android:stateListAnimator="@animator/tv_card_elevation">

    <!-- Top line: Flag + Round + Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivGpFlag"
            android:layout_width="30dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvGpRound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="R21"
            android:textColor="@color/f1_red"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvGpStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2563EB"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="PRÓXIMA"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- GP Name & Location -->
    <TextView
        android:id="@+id/tvGpName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Las Vegas Grand Prix"
        android:textColor="@color/text_primary"
        android:textSize="14.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGpCircuit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Las Vegas Strip Circuit • Nevada"
        android:textColor="@color/text_secondary"
        android:textSize="11.5sp" />

    <TextView
        android:id="@+id/tvGpDates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="19 Nov - 22 Nov • Hora Colombia"
        android:textColor="@color/neon_cyan"
        android:textSize="10.5sp"
        android:textStyle="bold" />
</LinearLayout>
