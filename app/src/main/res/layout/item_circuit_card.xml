<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="185dp"
    android:layout_height="130dp"
    android:layout_marginHorizontal="7dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/card_focus_selector"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="10dp"
    android:stateListAnimator="@animator/tv_card_elevation">

    <!-- Circuit outline silhouette image -->
    <ImageView
        android:id="@+id/ivCircuitSilhouette"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvCircuitCardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Interlagos"
        android:textColor="@color/text_primary"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCircuitCardLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="São Paulo • Brazil"
        android:textColor="@color/text_secondary"
        android:textSize="10.5sp" />
</LinearLayout>
