<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:fillViewport="true"
    android:paddingBottom="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============================================== -->
        <!-- 1. HERO PRINCIPAL: PRÓXIMO GRAN PREMIO CINEMATOGRÁFICO -->
        <!-- ============================================== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardHero"
            android:layout_width="match_parent"
            android:layout_height="275dp"
            android:layout_margin="10dp"
            app:cardBackgroundColor="#0D111A"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Cinematic Backdrop with Racing Red Stripe -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_cinematic" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="32dp"
                    android:paddingVertical="18dp">

                    <!-- Left: Metadata & Contextual Action Buttons -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Status Badge + Countdown -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvHeroStateBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:background="#2563EB"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="⏳ PRÓXIMO GRAN PREMIO"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvHeroCountdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="En 2 días"
                                android:textColor="#00F0FF"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Grand Prix Title -->
                        <TextView
                            android:id="@+id/tvHeroTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="FORMULA 1 HEINEKEN SILVER LAS VEGAS GRAND PRIX 2026"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <!-- Subtitle: Circuit & Location -->
                        <TextView
                            android:id="@+id/tvHeroSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Las Vegas Strip Circuit • Nevada, Estados Unidos"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <!-- Local Colombia Time -->
                        <TextView
                            android:id="@+id/tvHeroColombiaTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="📅 Próxima Sesión • Hora Colombia (GMT-5)"
                            android:textColor="@color/f1_red"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Action Buttons Row (TV D-Pad optimized) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnHeroWatchLive"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:background="@drawable/btn_tab_selector"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="18dp"
                                android:text="🏎️ Muro de Pits &amp; Previa"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnHeroViewGp"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/btn_tab_selector"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="16dp"
                                android:text="📅 Horarios y Circuito"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <Button
                                android:id="@+id/btnHeroResults"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/btn_tab_selector"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="16dp"
                                android:text="📊 Resultados São Paulo"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Right Visuals: Circuit Map + National Flag -->
                    <LinearLayout
                        android:layout_width="220dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivHeroFlag"
                            android:layout_width="54dp"
                            android:layout_height="34dp"
                            android:layout_marginBottom="8dp"
                            android:scaleType="fitCenter" />

                        <ImageView
                            android:id="@+id/ivHeroCircuitMap"
                            android:layout_width="200dp"
                            android:layout_height="145dp"
                            android:background="#121722"
                            android:padding="8dp"
                            android:scaleType="fitCenter" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============================================== -->
        <!-- 2. RESULTADOS OFICIALES INTEGRADOS (GP SÃO PAULO) -->
        <!-- ============================================== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRecentResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#111622"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRecentResultsBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="#15803D"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="🏁 ÚLTIMO GP FINALIZADO"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRecentResultsDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Fecha oficial: 8 de noviembre de 2026"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnViewFullResults"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/btn_tab_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="14dp"
                        android:text="📊 Ver Clasificación Oficial"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Race Title & Circuit -->
                <TextView
                    android:id="@+id/tvRecentResultsGpTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Grande Prêmio de São Paulo 2026"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecentResultsCircuit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Autódromo José Carlos Pace (Interlagos) • São Paulo, Brasil"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Official Podium Cards Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- P1 Winner -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#1A2232"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🥇"
                            android:textSize="22sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPodium1Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lando Norris"
                                android:textColor="#FF8000"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPodium1Team"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="McLaren • Ganador (25 pts)"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- P2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="#1A2232"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🥈"
                            android:textSize="22sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPodium2Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Max Verstappen"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPodium2Team"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Red Bull Racing • 2º (18 pts)"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- P3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="#1A2232"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🥉"
                            android:textSize="22sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPodium3Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Isack Hadjar"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPodium3Team"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Red Bull Racing • 3º (15 pts)"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============================================== -->
        <!-- 3. ACCESOS DE NAVEGACIÓN Y CATEGORÍAS         -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="EXPLORAR PLATAFORMA"
                android:textColor="@color/f1_red"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCircularHubs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- 4. CARRUSEL: GRANDES PREMIOS DE LA TEMPORADA  -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="🏁 GRANDES PREMIOS DE LA TEMPORADA 2026"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="← Pasadas | Siguiente: Las Vegas | Próximas →"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarouselGp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- 5. CARRUSEL: MUNDIAL DE PILOTOS (STANDINGS REAL) -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/sectionDrivers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="🏆 CAMPEONATO MUNDIAL DE PILOTOS 2026"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Líder: A. Kimi Antonelli (390 pts) • Orden Oficial"
                    android:textColor="#00F0FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarouselDrivers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- 6. CARRUSEL: MUNDIAL DE CONSTRUCTORES         -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/sectionConstructors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="🛠️ CAMPEONATO MUNDIAL DE CONSTRUCTORES 2026"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Líder: Mercedes (652 pts) • Orden Oficial"
                    android:textColor="#27F4D2"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarouselConstructors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- 7. CARRUSEL: CIRCUITOS DEL MUNDIAL            -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:text="🗺️ CIRCUITOS Y TRAZADOS OFICIALES"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarouselCircuits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
