<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:fillViewport="true"
    android:paddingBottom="56dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- ============================================== -->
        <!-- 1. HERO PRINCIPAL: GRAN PREMIO DOMINANTE       -->
        <!-- ============================================== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardHero"
            android:layout_width="match_parent"
            android:layout_height="290dp"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#0B111C"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Cinematic Ambient Backdrop -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_cinematic" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="36dp"
                    android:paddingVertical="20dp">

                    <!-- Left: Metadata & Contextual Action Buttons (65% width) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Eyebrow & Status Badge Row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvHeroStateBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:background="#2563EB"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text=""
                                tools:text="⏳ PRÓXIMO GRAN PREMIO"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvHeroCountdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text=""
                                tools:text="En 2 días"
                                android:textColor="@color/neon_cyan"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Grand Prix Main Title -->
                        <TextView
                            android:id="@+id/tvHeroTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text=""
                            tools:text="Gran Premio de Las Vegas"
                            android:textColor="@color/text_primary"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <!-- Subtitle: Circuit & Location -->
                        <TextView
                            android:id="@+id/tvHeroSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text=""
                            tools:text="Las Vegas Strip Circuit • Nevada, Estados Unidos"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <!-- Local Colombia Time Chip -->
                        <TextView
                            android:id="@+id/tvHeroColombiaTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="#50121C2B"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text=""
                            tools:text="📅 Próxima Sesión • Hora Colombia (GMT-5)"
                            android:textColor="@color/neon_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Action Buttons Row (Unified single primary action + pitwall access) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal">

                            <!-- Primary Action Button: Consultar detalles y horarios del GP -->
                            <Button
                                android:id="@+id/btnHeroViewGp"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:background="@drawable/btn_tab_selector"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="20dp"
                                android:text="📅 Ver Detalles y Horarios"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:stateListAnimator="@animator/tv_card_elevation" />

                            <!-- Secondary Action Button: Muro de Pits -->
                            <Button
                                android:id="@+id/btnHeroWatchLive"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="14dp"
                                android:background="@drawable/btn_tab_selector"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="18dp"
                                android:text="🏎️ Muro de Pits"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:stateListAnimator="@animator/tv_card_elevation" />

                            <!-- Hidden reference button for programmatic compatibility -->
                            <Button
                                android:id="@+id/btnHeroResults"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Right Visuals: Circuit Map + National Flag (35% width) -->
                    <LinearLayout
                        android:layout_width="240dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivHeroFlag"
                            android:layout_width="60dp"
                            android:layout_height="36dp"
                            android:layout_marginBottom="10dp"
                            android:scaleType="fitCenter" />

                        <ImageView
                            android:id="@+id/ivHeroCircuitMap"
                            android:layout_width="220dp"
                            android:layout_height="150dp"
                            android:background="#151E2E"
                            android:padding="10dp"
                            android:scaleType="fitCenter" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============================================== -->
        <!-- 2. ÚLTIMA CARRERA: RESULTADOS & PODIO OFICIAL  -->
        <!-- ============================================== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRecentResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#0F1624"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Header Row: Category Badge + Date + Action -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRecentResultsBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="#15803D"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="🏁 ÚLTIMO GP FINALIZADO"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRecentResultsDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text=""
                        tools:text="Fecha oficial: 8 de noviembre de 2026"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnViewFullResults"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/btn_tab_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="16dp"
                        android:text="📊 Ver Clasificación Oficial"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@animator/tv_card_elevation" />
                </LinearLayout>

                <!-- Race Title & Circuit -->
                <TextView
                    android:id="@+id/tvRecentResultsGpTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Último Gran Premio Finalizado"
                    tools:text="Grande Prêmio de São Paulo 2026"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecentResultsCircuit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    tools:text="Autódromo José Carlos Pace (Interlagos) • São Paulo, Brasil"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Official Podium Cards Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <!-- P1 Winner -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#151E2E"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🥇"
                            android:textSize="24sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPodium1Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                tools:text="Lando Norris"
                                android:textColor="#FF9500"
                                android:textSize="14.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPodium1Team"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                tools:text="McLaren • Ganador (25 pts)"
                                android:textColor="@color/text_secondary"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- P2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="#151E2E"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🥈"
                            android:textSize="24sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPodium2Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                tools:text="Max Verstappen"
                                android:textColor="@color/text_primary"
                                android:textSize="14.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPodium2Team"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                tools:text="Red Bull Racing • 2º (18 pts)"
                                android:textColor="@color/text_secondary"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- P3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="#151E2E"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🥉"
                            android:textSize="24sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPodium3Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                tools:text="Isack Hadjar"
                                android:textColor="@color/text_primary"
                                android:textSize="14.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPodium3Team"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                tools:text="Red Bull Racing • 3º (15 pts)"
                                android:textColor="@color/text_secondary"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============================================== -->
        <!-- 3. TEMPORADA: MUNDIAL DE PILOTOS              -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/sectionDrivers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="🏆 CAMPEONATO MUNDIAL DE PILOTOS 2026"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDriversSectionSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Clasificación Oficial"
                    tools:text="Líder: A. Kimi Antonelli (390 pts) • Orden Oficial"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarouselDrivers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- 4. TEMPORADA: MUNDIAL DE CONSTRUCTORES        -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/sectionConstructors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="🛠️ CAMPEONATO MUNDIAL DE CONSTRUCTORES 2026"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConstructorsSectionSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Clasificación Oficial"
                    tools:text="Líder: Mercedes (652 pts) • Orden Oficial"
                    android:textColor="#27F4D2"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarouselConstructors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- 5. EXPLORAR: CALENDARIO DE GRANDES PREMIOS     -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="🏁 GRANDES PREMIOS DE LA TEMPORADA 2026"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="← Temporada Oficial F1 →"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarouselGp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- 6. EXPLORAR: CIRCUITOS Y TRAZADOS DEL MUNDIAL  -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="🗺️ CIRCUITOS Y TRAZADOS OFICIALES"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarouselCircuits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
