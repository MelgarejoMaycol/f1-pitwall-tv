<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="205dp"
    android:layout_height="190dp"
    android:layout_marginHorizontal="7dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/card_focus_selector"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp"
    android:stateListAnimator="@animator/tv_card_elevation">

    <!-- Top line: Team accent bar + Rank badge + Wins -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewConstructorColor"
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:background="@color/f1_red" />

        <TextView
            android:id="@+id/tvConstructorRank"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:background="#202A3C"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text=""
            tools:text="1º"
            android:textColor="#FFD700"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvConstructorWins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            tools:text="🏆 12 Vict."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center: Official Team Crest Uniform Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="84dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="#152132"
            android:gravity="center"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ivConstructorLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </FrameLayout>

    <!-- Team Name -->
    <TextView
        android:id="@+id/tvConstructorName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        tools:text="Escudería F1"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Drivers -->
    <TextView
        android:id="@+id/tvConstructorDrivers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        tools:text="Piloto 1 • Piloto 2"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- Bottom: Points and Gap -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvConstructorPoints"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            tools:text="652 pts"
            android:textColor="@color/neon_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConstructorGap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            tools:text="LÍDER"
            android:textColor="#22C55E"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
