<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="185dp"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/card_focus_selector"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top line: Team accent bar + Rank badge + Wins -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewConstructorColor"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:background="@color/f1_red" />

        <TextView
            android:id="@+id/tvConstructorRank"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:background="#202A3D"
            android:gravity="center"
            android:paddingHorizontal="7dp"
            android:text="1º"
            android:textColor="#FFB800"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvConstructorWins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 12 Vict."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center: Official Team Crest Uniform Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="76dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:background="#152132"
            android:gravity="center"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivConstructorLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </FrameLayout>

    <!-- Team Name -->
    <TextView
        android:id="@+id/tvConstructorName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Mercedes-AMG"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Drivers -->
    <TextView
        android:id="@+id/tvConstructorDrivers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Antonelli • Russell"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <!-- Bottom: Points and Gap -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvConstructorPoints"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="652 pts"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConstructorGap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LÍDER"
            android:textColor="#22C55E"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
